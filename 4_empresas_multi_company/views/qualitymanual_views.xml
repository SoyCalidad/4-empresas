<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmtsystem_qualitymanual_form" model="ir.ui.view">
        <field name="name">mgmtsystem.qualitymanual.form.view.inherit.multi_company</field>
        <field name="model">mgmtsystem.qualitymanual</field>
        <field name="inherit_id" ref="mgmtsystem_qualitymanual.view_mgmtsystem_qualitymanual_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Multi-Compañía" name="multi_company" groups="base.group_multi_company">
                    <group>
                        <field name="company_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
