                    <group>
                        <field name="company_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="report_line_view_tree" model="ir.ui.view">
        <field name="name">report.line.view.tree.inherit.multi_company</field>
