<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mgmtsystem_action_type_view_tree" model="ir.ui.view">
        <field name="name">mgmtsystem.action.type.view.tree.inherit.multi_company</field>
        <field name="model">mgmtsystem.action.type</field>
        <field name="inherit_id" ref="mgmtsystem_action.mgmtsystem_action_type_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="mgmtsystem_action_type_view_form" model="ir.ui.view">
        <field name="name">mgmtsystem.action.type.view.form.inherit.multi_company</field>
        <field name="model">mgmtsystem.action.type</field>
        <field name="inherit_id" ref="mgmtsystem_action.mgmtsystem_action_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//group" position="after">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
