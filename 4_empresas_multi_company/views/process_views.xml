<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mgmt_categ_view_tree" model="ir.ui.view">
        <field name="name">mgmt.categ.view.tree.inherit.multi_company</field>
        <field name="model">mgmt.categ</field>
        <field name="inherit_id" ref="mgmtsystem_process.mgmt_categ_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

