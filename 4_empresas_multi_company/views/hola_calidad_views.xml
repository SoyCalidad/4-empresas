<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hola_calidad_diagnostic_form" model="ir.ui.view">
        <field name="name">hola_calidad.diagnostic.form.inherit.multi_company</field>
        <field name="model">hola_calidad.diagnostic</field>
        <field name="inherit_id" ref="hola_calidad.hola_calidad_diagnostic_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="groups">base.group_multi_company</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Multi-Compañía" name="multi_company" groups="base.group_multi_company">
                    <group>
                        <field name="company_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hola_calidad_diagnostic_tree" model="ir.ui.view">
        <field name="name">hola_calidad.diagnostic.tree.inherit.multi_company</field>
        <field name="model">hola_calidad.diagnostic</field>
        <field name="inherit_id" ref="hola_calidad.hola_calidad_diagnostic_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="hola_calidad_diagnostic_line_form" model="ir.ui.view">
        <field name="name">hola_calidad.diagnostic.line.form.inherit.multi_company</field>
        <field name="model">hola_calidad.diagnostic.line</field>
        <field name="inherit_id" ref="hola_calidad.hola_calidad_diagnostic_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/group" position="inside">
                <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>
</odoo>
