<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmtsystem_plan_tree" model="ir.ui.view">
        <field name="name">mgmtsystem.plan.tree.inherit.multi_company</field>
        <field name="model">mgmtsystem.plan</field>
        <field name="inherit_id" ref="mgmtsystem_employees.view_mgmtsystem_plan_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_mgmtsystem_plan_form" model="ir.ui.view">
        <field name="name">mgmtsystem.plan.form.inherit.multi_company</field>
        <field name="model">mgmtsystem.plan</field>
        <field name="inherit_id" ref="mgmtsystem_employees.view_mgmtsystem_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Multi-Compañía" name="multi_company" groups="base.group_multi_company">
                    <group>
                        <field name="company_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_mgmtsystem_plan_training_tree" model="ir.ui.view">
        <field name="name">mgmtsystem.plan.training.tree.inherit.multi_company</field>
        <field name="model">mgmtsystem.plan.training</field>
        <field name="inherit_id" ref="mgmtsystem_employees.view_mgmtsystem_plan_training_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_mgmtsystem_plan_training_form" model="ir.ui.view">
        <field name="name">mgmtsystem.plan.training.form.inherit.multi_company</field>
        <field name="model">mgmtsystem.plan.training</field>
        <field name="inherit_id" ref="mgmtsystem_employees.view_mgmtsystem_plan_training_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Multi-Compañía" name="multi_company" groups="base.group_multi_company">
                    <group>
                        <field name="company_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_mgmtsystem_plan_training_line_tree" model="ir.ui.view">
        <field name="name">mgmtsystem.plan.training.line.tree.inherit.multi_company</field>
        <field name="model">mgmtsystem.plan.training.line</field>
        <field name="inherit_id" ref="mgmtsystem_employees.view_mgmtsystem_plan_training_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_mgmtsystem_plan_training_line_form" model="ir.ui.view">
        <field name="name">mgmtsystem.plan.training.line.form.inherit.multi_company</field>
        <field name="model">mgmtsystem.plan.training.line</field>
        <field name="inherit_id" ref="mgmtsystem_employees.view_mgmtsystem_plan_training_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//sheet//group//group" position="inside">
                <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>
</odoo>
