<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_complaint_plan_tree" model="ir.ui.view">
        <field name="name">complaint.analisis.tree.inherit.multi_company</field>
        <field name="model">complaint.analisis</field>
        <field name="inherit_id" ref="mgmtsystem_complaints.view_complaint_plan_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_complaint_plan_form" model="ir.ui.view">
        <field name="name">complaint.analisis.form.inherit.multi_company</field>
        <field name="model">complaint.analisis</field>
        <field name="inherit_id" ref="mgmtsystem_complaints.view_complaint_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Multi-Compañía" name="multi_company" groups="base.group_multi_company">
                    <group>
                        <field name="company_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_complaint_complaint_tree" model="ir.ui.view">
        <field name="name">complaint.complaint.tree.inherit.multi_company</field>
        <field name="model">complaint.complaint</field>
        <field name="inherit_id" ref="mgmtsystem_complaints.view_complaint_complaint_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_complaint_complaint_form" model="ir.ui.view">
        <field name="name">complaint.complaint.form.inherit.multi_company</field>
        <field name="model">complaint.complaint</field>
        <field name="inherit_id" ref="mgmtsystem_complaints.view_complaint_complaint_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Multi-Compañía" name="multi_company" groups="base.group_multi_company">
                    <group>
                        <field name="company_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
