<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mgmtsystem_mof_view_tree" model="ir.ui.view">
        <field name="name">mgmtsystem.mof.view.tree.inherit.multi_company</field>
        <field name="model">mgmtsystem.mof</field>
        <field name="inherit_id" ref="mgmtsystem_mof.mgmtsystem_mof_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="mgmtsystem_mof_view_form" model="ir.ui.view">
        <field name="name">mgmtsystem.mof.view.form.inherit.multi_company</field>
        <field name="model">mgmtsystem.mof</field>
        <field name="inherit_id" ref="mgmtsystem_mof.mgmtsystem_mof_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Multi-Compañía" name="multi_company" groups="base.group_multi_company">
                    <group>
                        <field name="company_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
