<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_legal_legal_tree" model="ir.ui.view">
        <field name="name">legal.legal.tree.inherit.multi_company</field>
        <field name="model">legal.legal</field>
        <field name="inherit_id" ref="mgmtsystem_legal.view_legal_legal_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_legal_legal_form" model="ir.ui.view">
        <field name="name">legal.legal.form.inherit.multi_company</field>
        <field name="model">legal.legal</field>
        <field name="inherit_id" ref="mgmtsystem_legal.view_legal_legal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Multi-Compañía" name="multi_company" groups="base.group_multi_company">
                    <group>
                        <field name="company_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_legal_article_tree" model="ir.ui.view">
        <field name="name">legal.article.tree.inherit.multi_company</field>
        <field name="model">legal.article</field>
        <field name="inherit_id" ref="mgmtsystem_legal.view_legal_article_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_legal_article_form" model="ir.ui.view">
        <field name="name">legal.article.form.inherit.multi_company</field>
        <field name="model">legal.article</field>
        <field name="inherit_id" ref="mgmtsystem_legal.view_legal_article_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//sheet//group" position="after">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_legal_plan_tree" model="ir.ui.view">
        <field name="name">legal.plan.tree.inherit.multi_company</field>
        <field name="model">legal.plan</field>
        <field name="inherit_id" ref="mgmtsystem_legal.view_legal_plan_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_legal_plan_form" model="ir.ui.view">
        <field name="name">legal.plan.form.inherit.multi_company</field>
        <field name="model">legal.plan</field>
        <field name="inherit_id" ref="mgmtsystem_legal.view_legal_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Multi-Compañía" name="multi_company" groups="base.group_multi_company">
                    <group>
                        <field name="company_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_legal_plan_line_form" model="ir.ui.view">
        <field name="name">legal.plan.line.form.inherit.multi_company</field>
        <field name="model">legal.plan.line</field>
        <field name="inherit_id" ref="mgmtsystem_legal.view_legal_plan_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_legal_plan_history_form" model="ir.ui.view">
        <field name="name">legal.plan.history.form.inherit.multi_company</field>
        <field name="model">legal.plan.history</field>
        <field name="inherit_id" ref="mgmtsystem_legal.view_legal_plan_history_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>
</odoo>
