<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_survey_report_actionnonc_tree" model="ir.ui.view">
        <field name="name">survey.report.actionnonc.tree.inherit.multi_company</field>
        <field name="model">survey.report.actionnonc</field>
        <field name="inherit_id" ref="mgmtsystem_survey.view_survey_report_actionnonc_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="survey_tree" model="ir.ui.view">
        <field name="name">survey.survey.view.tree.inherit.multi_company</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="survey_form" model="ir.ui.view">
        <field name="name">survey.survey.view.form.inherit.multi_company</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Multi-Compañía" name="multi_company" groups="base.group_multi_company">
                    <group>
                        <field name="company_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="survey_question_tree" model="ir.ui.view">
        <field name="name">survey.question.view.tree.inherit.multi_company</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="survey_question_form" model="ir.ui.view">
        <field name="name">survey.question.view.form.inherit.multi_company</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Multi-Compañía" name="multi_company" groups="base.group_multi_company">
                    <group>
                        <field name="company_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="survey_user_input_view_tree" model="ir.ui.view">
        <field name="name">survey.user_input.view.tree.inherit.multi_company</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="survey_user_input_view_form" model="ir.ui.view">
        <field name="name">survey.user_input.view.form.inherit.multi_company</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='test_entry']" position="after">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="survey_response_line_tree" model="ir.ui.view">
        <field name="name">survey.user_input_line.view.tree.inherit.multi_company</field>
        <field name="model">survey.user_input_line</field>
        <field name="inherit_id" ref="survey.survey_response_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="survey_user_input_line_form" model="ir.ui.view">
        <field name="name">survey.user_input_line.view.form.inherit.multi_company</field>
        <field name="model">survey.user_input_line</field>
        <field name="inherit_id" ref="survey.survey_user_input_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='skipped']" position="after">
              <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>
</odoo>
