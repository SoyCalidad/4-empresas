<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.rule" id="mgmtsystem_audit.mgmt_owner_document">
        <field name="name">Usuario secundario: Lectura Edición de documentos propios</field>
        <field name="model_id" ref="model_audit_plan" />
        <field name="groups" eval="[(4, ref('mgmtsystem_audit.group_audit_write_printreport'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
        <field name="domain_force">[('responsable_id','in',[user.id])]</field>
    </record>

    <record model="ir.rule" id="mgmtsystem_audit.mgmt_noowner_document">
        <field name="name">Usuario secundario: Documentos ajenos</field>
        <field name="model_id" ref="model_audit_plan" />
        <field name="groups" eval="[(4, ref('mgmtsystem_audit.group_audit_write_printreport'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
        <field name="domain_force">[('responsable_id','not in',[user.id])]</field>
    </record>
</odoo>
