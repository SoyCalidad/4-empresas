<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_equipment_type_view_tree" model="ir.ui.view">
        <field name="name">maintenance.equipment.type.view.tree</field>
        <field name="model">maintenance.equipment.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="maintenance_equipment_type_view_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.type.view.form</field>
        <field name="model">maintenance.equipment.type</field>
        <field name="arch" type="xml">
            <form>
                <field name="active" invisible="1" />
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence" groups="base.group_no_one"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="maintenance_equipment_type_action" model="ir.actions.act_window">
        <field name="name">Tipos de Equipos</field>
        <field name="res_model">maintenance.equipment.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay tipos de equipos. ¡Vamos a crear uno!
            </p>
        </field>
    </record>
</odoo>
