<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Complaint Form View -->
    <record id="view_complaint_complaint_form_multicompany" model="ir.ui.view">
        <field name="name">complaint.complaint.form.multicompany</field>
        <field name="model">complaint.complaint</field>
        <field name="inherit_id" ref="mgmtsystem_complaints.view_complaint_complaint_form"/>
        <field name="arch" type="xml">
            <field name="elaborate_ids" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
            </field>
        </field>
    </record>

    <!-- Complaint Tree View -->
    <record id="view_complaint_complaint_tree_multicompany" model="ir.ui.view">
        <field name="name">complaint.complaint.tree.multicompany</field>
        <field name="model">complaint.complaint</field>
        <field name="inherit_id" ref="mgmtsystem_complaints.view_complaint_complaint_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
            </field>
        </field>
    </record>



