    <!-- ========================================== -->
    <!-- MENU ACTIONS - Filtrar por Compañía -->
    <!-- ========================================== -->

    <!-- Action para Complaints filtrado por compañía actual -->
    <record id="action_complaint_complaint_company" model="ir.actions.act_window">
        <field name="name">Company Complaints</field>
        <field name="res_model">complaint.complaint</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('company_id', '=', active_company)]</field>
        <field name="context">{
            'default_company_id': active_company,
            'search_default_group_company': 1
        }</field>
        <field name="help">Complaints for current company</field>
    </record>

